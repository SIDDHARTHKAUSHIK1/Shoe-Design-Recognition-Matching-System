{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "ShoeMatch AI",
  "version": "1.0.0",
  "identifier": "com.shoematch.ai",
  "build": {
    "frontendDist": "../frontend",
    "devUrl": "http://localhost:8000"
  },
  "app": {
    "windows": [
      {
        "title": "ShoeMatch AI — Visual Match Studio",
        "width": 1280,
        "height": 830,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
