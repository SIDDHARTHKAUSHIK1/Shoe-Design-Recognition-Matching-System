# ==============================================================================
# ShoeMatch AI — Environment Configuration Example
# Copy this file to '.env' for local development or set in environment / deployment secrets.
# ==============================================================================

# Application Host & Port
HOST=195.35.6.176
PORT=8000
DEBUG=false

# Security & Secret Keys
# IMPORTANT: Generate a strong random key in production!
SECRET_KEY=change_this_to_a_random_secure_64_char_hex_secret_key_in_production

# Initial Seed Credentials (Overridden if already set in database)
ADMIN_PASSWORD=change_admin_password_on_first_login_123!
EMPLOYEE_PASSWORD=change_emp_password_on_first_login_123!

# CORS Allowed Origins (Comma-separated origins, or leave blank for default localhost origins)
# Example: ALLOWED_ORIGINS=https://shoematch.shop,https://app.shoematch.shop
ALLOWED_ORIGINS=https://shoe.aflix.co.in,http://127.0.0.1:8000
