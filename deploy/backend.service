[Unit]
Description=ShoeMatch AI - FastAPI & PyTorch Visual Search Backend Server
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/var/www/shoematch
ExecStart=/var/www/shoematch/venv/bin/python -u run_server.py

# Auto-Restart & Failover Rules
Restart=always
RestartSec=5s
KillMode=mixed
TimeoutStopSec=15s

# Environment Variables
Environment=PYTHONUNBUFFERED=1
Environment=PORT=8000
Environment=HOST=0.0.0.0

# Process & File Descriptor Limits
LimitNOFILE=65536
LimitNPROC=4096

# Log Output Redirection
StandardOutput=journal
StandardError=journal
SyslogIdentifier=shoematch-backend

[Install]
WantedBy=multi-user.target
