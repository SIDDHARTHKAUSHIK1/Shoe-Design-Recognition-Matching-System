# ==============================================================================
# ShoeMatch AI — Production environment (VPS)
# Copy to the REPO ROOT as .env on the server, then fill in real values:
#     cp deploy/vps/.env.production.example .env && nano .env
# This file is gitignored at the root. Never commit the filled-in version.
# ==============================================================================

HOST=0.0.0.0
PORT=8000
DEBUG=false
WORKERS=1

# ---- Signing key -------------------------------------------------------------
# REQUIRED. backend/auth.py falls back to a key that is committed to the public
# repo; if this is unset, anyone who reads the repo can forge admin tokens.
# Generate with:  openssl rand -hex 32
SECRET_KEY=

# ---- Seed credentials --------------------------------------------------------
# Only used the first time the database is created.
ADMIN_PASSWORD=
EMPLOYEE_PASSWORD=

# ---- CORS --------------------------------------------------------------------
# Your Hostinger frontend origin(s), comma-separated, no trailing slash.
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ---- Model -------------------------------------------------------------------
EMBEDDING_MODEL=facebook/dinov2-small
ENABLE_TTA=true
TTA_CROPS=2
ENABLE_COLOR_AWARE_SCORING=true
