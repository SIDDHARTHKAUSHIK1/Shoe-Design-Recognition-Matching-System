# ==============================================================================
# Hostinger FTP credentials  —  copy to  deploy/hostinger/.ftp.env  and fill in.
# That filename is gitignored. Never commit the filled-in version.
#
# Find these in hPanel:  Files  ->  FTP Accounts
# ==============================================================================

# FTP hostname. Usually your domain, or the IP shown in hPanel.
FTP_HOST=ftp.yourdomain.com

# FTP username — Hostinger format looks like u123456789.yourdomain.com
FTP_USER=

# FTP password
FTP_PASS=

# Remote web root.
#   Primary domain on the account : /public_html
#   Addon / secondary domain      : /domains/yourdomain.com/public_html
FTP_REMOTE_DIR=/public_html

# Public URL, used only to verify the upload afterwards. No trailing slash.
SITE_URL=https://yourdomain.com
